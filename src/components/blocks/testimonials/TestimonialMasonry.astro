---

import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
import TestimonialCard from '../../ui/cards/TestimonialCard.astro'
import Header from '../../ui/Header.astro'

// Content
type Props = {
	title?: string
	subtitle?: string
}
const { 
    title = 'Suara dari Komunitas', 
    subtitle = 'Hasil nyata dari penerapan strategi investasi berbasis data dan aksi korporasi.' 
} = Astro.props
---

<Section classes="bg-neutral-300/20! dark:bg-neutral-600/20!">
	<Row classes="bg-white/20! dark:bg-neutral-950/20!">
		<Col span="12" classes="pt-16 lg:pt-24 pb-8!" style="transparent">
			<Header title={title} subtitle={subtitle} headingLevel="h2" titleWidth="max-w-2xl" />
		</Col>
	</Row>
	<Row decorationBorder="bottom left right" style="transparent">
		<Col span="8" style="transparent">
			<TestimonialCard
				quote="Awalnya saya ragu dengan isu akuisisi sebuah emiten, tapi setelah melihat bedah tuntas di KronixSignals, saya berani masuk besar. Hasilnya aset tumbuh signifikan dalam hitungan bulan."
				quoteClasses="max-w-[42rem] lgmax-w-[50rem]"
				author="Member #042"
				position="Investor Retail"
				decorationType="left right bottom"
			/>
		</Col>
		<Col span="4" style="transparent">
			<TestimonialCard
				quote="Teknik membaca Bid-Offer yang diajarkan sangat presisi. Saya sekarang bisa mendeteksi distribusi terselubung dengan lebih cepat."
				quoteClasses="max-w-[42rem] lgmax-w-[50rem]"
				author="Anonim"
				position="Day Trader"
				decorationType="left right bottom"
			/>
		</Col>
		<Col span="4" style="transparent" classes="flex flex-col gap-8">
			<TestimonialCard
				quote="Analisis fundamental dan screening saham multibagger-nya sangat objektif. Sangat membantu untuk kami yang tidak punya banyak waktu memantau running trade."
				author="Private Client"
				position="Swing Investor"
				decorationType="top left right bottom"
			/>
		</Col>
		<Col span="8" style="transparent">
			<TestimonialCard
				quote="Fokus pada Aksi Korporasi seperti Rights Issue dan Merger benar-benar membuka mata saya. Strategi di sini bukan sekadar tebak-tebakan, tapi ada logika bisnis yang kuat di baliknya."
				author="Member Gold"
				position="Corporate Action Specialist"
				decorationType="top left right bottom"
				classes="h-full"
			/>
		</Col>
	</Row>
</Section>

<style>
	@reference '../../../styles/global.css';
	.col {
		@apply flex basis-1/2! items-center justify-center md:basis-1/3! md:last:hidden lg:basis-1/5! lg:last:flex;
	}
</style>