---
// Sticky FAQ
// ------------
// Description: A sticky FAQ section with a title and a subtitle
// Properties:
// - title: The title of the hero section
// - text: The subtitle of the hero section
// - classes: Additional classes to be added to the hero section

// Components
// - Layout
import SectionSticky from '../../blocks/basic/StickySidebar.astro'
// - UI
import Header from '../../ui/Header.astro'
import DecorationBorder from '../../ui/DecorationBorder.astro'

// Content
// - Props
type Props = {
	title?: string
	subtitle?: string
	classes?: string
}
const { title = '', subtitle = '', classes = '' } = Astro.props
---

<SectionSticky classes={`${classes ? classes : ''}`}>
	<Header
		title={title}
		subtitle={subtitle}
		headingLevel="h2"
		titleClasses="bg-white dark:bg-neutral-950 "
		slot="sidebar"
	/>

	<div class="faq">
		<div class="faq__item">
			<h3 class="faq__item__title">Apakah pemula yang belum pernah trading bisa ikut?</h3>
			<p class="faq__item__text">
				Tentu saja. Kami memberikan edukasi dari dasar sekali, mulai dari cara jual-beli di aplikasi hingga cara membaca bid-offer (antrean beli dan jual) agar Anda tidak salah langkah saat eksekusi.
			</p>
			<DecorationBorder type="top bottom" style="dashed" />
		</div>
		<div class="faq__item">
			<h3 class="faq__item__title">Apa bedanya paket Platinum dan Gold?</h3>
			<p class="faq__item__text">
				Platinum adalah sistem langganan bulanan (Rp 150rb). Gold adalah paket tahunan (Rp 1,6jt) yang jauh lebih hemat, sudah termasuk semua fitur Platinum plus konsultasi portofolio prioritas.
			</p>
			<DecorationBorder type="top bottom" style="dashed" />
		</div>
	</div>
</SectionSticky>

<style>
	@reference '../../../styles/global.css';
	.faq {
		@apply flex flex-col gap-6 lg:gap-8;
	}
	.faq__item {
		@apply relative bg-white p-6 lg:p-8 dark:bg-neutral-950;
	}
	.faq__item__title {
		@apply mb-2 text-2xl leading-8;
	}
	.faq__item__text {
		@apply mb-0 text-xl leading-8;
	}
</style>
