---
// Home Page
// ------------
// Description: The home page is a page that displays the most important information.

// Components
// - Layout
import Layout from '../layouts/Layout.astro'

// - Blocks
import Hero from '../components/blocks/hero/SimpleHeroBasic.astro'
import BasicTable from '../components/blocks/pricing/BasicTable.astro'
//import Brand from '../components/blocks/brand/Marquee.astro'
import Faq from '../components/blocks/faq/StickyFaq.astro'
import CTA from '../components/blocks/cta/CTAPrimary.astro'

// Content
// - SEO
const SEO = {
	title: 'Kronix Alpha | Pricing',
	description:
		'Find the right Mizu Light plan for your next project. Simple, transparent pricing for individuals, startups, and growing teams.'
}
// - Hero data
const heroData = {
	title: 'PILIHAN MEMBERSHIP KRONIX',
	subtitle: 'Simple, Fair Pricing',
	text: 'Baik Anda seorang trader aktif yang butuh pantauan momentum harian, maupun investor yang mencari saham untuk di-hold, kami punya ekosistem yang tepat. Tidak ada biaya tersembunyi.'
}
// - Brand data

// - FAQ data
const faqData = {
	title: 'Everything you need to know',
	subtitle: 'Frequently Asked Questions'
}
// - CTA data
const ctaData = {
	title: 'Amankan Kursi Anda di KronixSignals',
	text: 'Jangan lagi trading sendirian di tengah volatilitas IHSG. Pelajari cara baca Bid-Offer, analisis Bandarmology, dan temukan narasi aksi korporasi sebelum pasar menyadarinya.',
	buttonLink: '/pricing',
	buttonText: 'Join'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={heroData.title} subtitle={heroData.subtitle} text={heroData.text} />
	<BasicTable />
	<Faq subtitle={faqData.subtitle} title={faqData.title} />
	<CTA
		title={ctaData.title}
		text={ctaData.text}
		buttonLink={ctaData.buttonLink}
		buttonText={ctaData.buttonText}
	/>
</Layout>
